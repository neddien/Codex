{
    "version": 3,
    "configurePresets": [
        {
            "name": "base", "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir":  "${sourceDir}/builds/${presetName}",
            "installDir": "${sourceDir}/installs/${presetName}",
            "cacheVariables": {
                "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/conan-provider/conan_provider.cmake",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Shipping",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "CX_ENABLE_CEDITOR": "ON",
                "CX_ENABLE_TESTWORK": "OFF"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "windows-msvc",
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "windows-llvm",
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CONAN_HOST_PROFILE": "default;auto-cmake;${sourceDir}/cmake/conan-clangcl-profile"
            }
        },
        {
            "name": "windows-vs",
            "hidden": true,
            "inherits": "windows",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_DEFAULT_BUILD_TYPE": null,
                "CONAN_HOST_PROFILE": "default;auto-cmake;${sourceDir}/cmake/conan-ninja-profile"
            }
        },
        {
            "name": "windows-vs2022",
            "inherits": "windows-vs",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "windows-vs2026",
            "inherits": "windows-vs",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "linux-gcc",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-llvm",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ]
}
